    <TIER ANNOTATOR="zsk" LINGUISTIC_TYPE_REF="association" PARENT_REF="TX" PARTICIPANT="lam" TIER_ID="FT_EN">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3655" ANNOTATION_REF="a4">
                <ANNOTATION_VALUE>The Big Dipper.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3656" ANNOTATION_REF="a70">
                <ANNOTATION_VALUE>Seven sevens make forty-nine times.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3657" ANNOTATION_REF="a5">
                <ANNOTATION_VALUE>It goes through the clouds.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3658" ANNOTATION_REF="a71">
                <ANNOTATION_VALUE>It passes through the water.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3659" ANNOTATION_REF="a6">
                <ANNOTATION_VALUE>Who can say it seven times?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3660" ANNOTATION_REF="a7">
                <ANNOTATION_VALUE>I can say it seven times.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3661" ANNOTATION_REF="a8">
                <ANNOTATION_VALUE>The moonlight shines brightly and lights up every side.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3662" ANNOTATION_REF="a9">
                <ANNOTATION_VALUE>When every side is dark, it shines on the paddy-field bank.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3663" ANNOTATION_REF="a10">
                <ANNOTATION_VALUE>If the paddy-field bank is high, pick up a knife.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3664" ANNOTATION_REF="a11">
                <ANNOTATION_VALUE>If the paddy-field bank is low, pick up a child.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3665" ANNOTATION_REF="a12">
                <ANNOTATION_VALUE>Child, child, do not cry.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3666" ANNOTATION_REF="a13">
                <ANNOTATION_VALUE>I will take you to see a new house.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3667" ANNOTATION_REF="a14">
                <ANNOTATION_VALUE>Inside the new house there is a pond.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3668" ANNOTATION_REF="a15">
                <ANNOTATION_VALUE>Pick up a carp, as long as a shoulder pole.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3669" ANNOTATION_REF="a16">
                <ANNOTATION_VALUE>The father eats the head, and the child eats the waist.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3670" ANNOTATION_REF="a17">
                <ANNOTATION_VALUE>Leave the tail for the third-day birth celebration.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3671" ANNOTATION_REF="a18">
                <ANNOTATION_VALUE>Leave an intestine for the wet nurse.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3672" ANNOTATION_REF="a19">
                <ANNOTATION_VALUE>Leave the gallbladder for the boss.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3673" ANNOTATION_REF="a20">
                <ANNOTATION_VALUE>A tail-drooping bird, its tail droops.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3674" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>Carrying a sheng of rice, go to visit grandmother.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3675" ANNOTATION_REF="a22">
                <ANNOTATION_VALUE>Grandmother asks me to stay for lunch.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3676" ANNOTATION_REF="a23">
                <ANNOTATION_VALUE>What kind of rice?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3677" ANNOTATION_REF="a24">
                <ANNOTATION_VALUE>Chicken-soup rice.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3678" ANNOTATION_REF="a25">
                <ANNOTATION_VALUE>What kind of chicken?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
