    <TIER ANNOTATOR="zsk" LINGUISTIC_TYPE_REF="association" PARENT_REF="TX" PARTICIPANT="lam" TIER_ID="FT_JP">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3588" ANNOTATION_REF="a4">
                <ANNOTATION_VALUE>北斗七星。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3589" ANNOTATION_REF="a70">
                <ANNOTATION_VALUE>七七、四十九回。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3590" ANNOTATION_REF="a5">
                <ANNOTATION_VALUE>雲の中を突き抜けていく。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3591" ANNOTATION_REF="a71">
                <ANNOTATION_VALUE>水の中を通っていく。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3592" ANNOTATION_REF="a6">
                <ANNOTATION_VALUE>誰が七回言えるのか。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3593" ANNOTATION_REF="a7">
                <ANNOTATION_VALUE>私は七回言える。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3594" ANNOTATION_REF="a8">
                <ANNOTATION_VALUE>月の光が明るく、四方を照らす。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3595" ANNOTATION_REF="a9">
                <ANNOTATION_VALUE>四方が暗くなると、田のあぜを照らす。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3596" ANNOTATION_REF="a10">
                <ANNOTATION_VALUE>田のあぜが高ければ、刀を一振り拾う。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3597" ANNOTATION_REF="a11">
                <ANNOTATION_VALUE>田のあぜが低ければ、子どもを一人拾う。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3598" ANNOTATION_REF="a12">
                <ANNOTATION_VALUE>子どもよ、子どもよ、泣かないで。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3599" ANNOTATION_REF="a13">
                <ANNOTATION_VALUE>新しい家を見に連れて行こう。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3600" ANNOTATION_REF="a14">
                <ANNOTATION_VALUE>新しい家の中には池が一つある。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3601" ANNOTATION_REF="a15">
                <ANNOTATION_VALUE>鯉を一匹拾うと、天秤棒ほど長い。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3602" ANNOTATION_REF="a16">
                <ANNOTATION_VALUE>父は頭を食べ、子どもは腰を食べる。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3603" ANNOTATION_REF="a17">
                <ANNOTATION_VALUE>尾を残して、三朝祝いに使う。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3604" ANNOTATION_REF="a18">
                <ANNOTATION_VALUE>腸を一本残して、乳母に贈る。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3605" ANNOTATION_REF="a19">
                <ANNOTATION_VALUE>胆を一つ残して、親方に贈る。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3606" ANNOTATION_REF="a20">
                <ANNOTATION_VALUE>尾を垂れた鳥、尾が垂れている。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3607" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>一升の米を背負って、祖母に会いに行く。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3608" ANNOTATION_REF="a22">
                <ANNOTATION_VALUE>祖母は私を昼食に引き留める。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3609" ANNOTATION_REF="a23">
                <ANNOTATION_VALUE>どんなご飯か。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3610" ANNOTATION_REF="a24">
                <ANNOTATION_VALUE>鶏スープのご飯。</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
